# Copy to .env, edit paths, then export with: set -a; source .env; set +a
# Each model can also be supplied to its runner with --model-path.
MI4TC_MODEL_ROOT=/path/to/open-weight-models
MI4TC_TRANSCODER_ROOT=/path/to/transcoder-checkpoints
MI4TC_RELEASE_ROOT=/path/to/transcoder-checkpoints/release

# Optional per-model overrides; otherwise MI4TC_MODEL_ROOT/<model-name> is used.
# MI4TC_QWEN3_4B_PATH=/path/to/Qwen3-4B
# MI4TC_QWEN3_8B_PATH=/path/to/Qwen3-8B
# MI4TC_QWEN3_14B_PATH=/path/to/Qwen3-14B
# MI4TC_QWEN35_4B_PATH=/path/to/Qwen3.5-4B
# MI4TC_QWEN35_9B_PATH=/path/to/Qwen3.5-9B
# MI4TC_GRANITE_PATH=/path/to/granite-3.3-8b-instruct
# MI4TC_MISTRAL_PATH=/path/to/Mistral-Small-3.2-24B-Instruct-2506

# Optional alternative tau2 template directories (system prompt + tool schemas).
# MI4TC_TAU2_TELECOM_ROOT=/path/to/telecom
# MI4TC_TAU2_RETAIL_ROOT=/path/to/retail
