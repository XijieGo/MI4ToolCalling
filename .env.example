# These are direct paths, not a configuration system.  They are read only by
# model-backed studies and are intentionally not required for repository checks.
MI4TC_MODEL_ROOT=/path/to/open-weight-models
MI4TC_TRANSCODER_ROOT=/path/to/transcoder-checkpoints
MI4TC_QWEN3_8B_PATH=/path/to/open-weight-models/Qwen3-8B
MI4TC_GRANITE_PATH=/path/to/open-weight-models/granite-3.3-8b-instruct
MI4TC_MISTRAL_PATH=/path/to/open-weight-models/Mistral-Small-3.2-24B-Instruct-2506
